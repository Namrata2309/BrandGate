# Copy these values into backend/.env; do not commit a real API key.
# The defaults support OpenAI-compatible hosted APIs such as Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace_with_your_provider_key
LLM_MODEL=replace_with_a_current_model_id_from_your_provider
LLM_TIMEOUT_SECONDS=35
LLM_MAX_TOKENS=1400
